# AgroTrust AI – Microsserviço ESG (FastAPI/uvicorn)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8010

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir -e ".[core,ml]"

COPY core/ ./core/
COPY agents/ ./agents/
COPY services/ ./services/
COPY mocks/ ./mocks/

RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f "http://localhost:${PORT}/health" || exit 1

# Diretório com hífen não é importável como módulo → executa o arquivo diretamente
# (o __main__ do app sobe uvicorn na porta 8010).
CMD ["python", "services/agent-esg/app.py"]
