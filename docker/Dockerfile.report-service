# AgroTrust AI – Report Service (FastAPI/uvicorn + WeasyPrint + PyHanko)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8020

# Dependências de sistema do WeasyPrint (Pango/Cairo/GDK-PixBuf) + curl p/ healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libffi-dev \
        fonts-dejavu-core \
        gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir -e ".[core,report]"

COPY core/ ./core/
COPY services/ ./services/

RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8020

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f "http://localhost:${PORT}/health" || exit 1

# Diretório com hífen não é importável como módulo → executa o arquivo diretamente.
CMD ["python", "services/report-service/app.py"]
